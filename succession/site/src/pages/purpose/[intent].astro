---
import ListLayout from "@/layouts/ListLayout.astro";
import { getSiteData } from "@/utils/content";
import { ALL_INTENTS, INTENT_LABELS, isIntent } from "@/utils/labels";
import { articlesForIntent, emptyTargets, faceItems, listCrumbs, relatedTermLinks } from "@/utils/lists";
import { frameProps } from "@/utils/nav";
import { href } from "@/utils/url";

export async function getStaticPaths() {
  return ALL_INTENTS.map((intent) => ({ params: { intent } }));
}

const intent = Astro.params.intent;
if (!intent || !isIntent(intent)) throw new Error(`目的がない: ${intent}`);
const d = await getSiteData();
const articles = articlesForIntent(d, intent);
const label = INTENT_LABELS[intent];
const frame = await frameProps("list", { current: `purpose-${intent}` });
---

<ListLayout
  title={label.nav}
  description={label.lead}
  frame={frame}
  tab={label.nav}
  crumbs={listCrumbs([{ label: "目的", href: href("purpose/") }, { label: label.nav }])}
  heading={label.nav}
  lead={label.lead}
  faces={faceItems(articles, d)}
  terms={relatedTermLinks(d, articles)}
  empty={emptyTargets(d)}
/>
