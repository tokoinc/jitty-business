---
import { CheckPanel } from "@/generated/ui";
import ListLayout from "@/layouts/ListLayout.astro";
import { getSiteData } from "@/utils/content";
import { glossaryInReadingOrder, glossaryRows, listCrumbs } from "@/utils/lists";
import { frameProps } from "@/utils/nav";
import { glossaryHref, href } from "@/utils/url";

const d = await getSiteData();
const entries = glossaryInReadingOrder(d.glossary);
const rows = glossaryRows(d.glossary);
const frame = await frameProps("list", { current: "glossary" });
const lead = "五十音の行ごとに用語を並べています。";
---

<ListLayout
  title="用語集"
  description={lead}
  frame={frame}
  tab="用語集"
  crumbs={listCrumbs([{ label: "用語集" }])}
  heading="用語集"
  lead={lead}
>
  {rows.length > 0 && (
    <nav aria-label="五十音の行">
      <ul class="dd-kana-toc">
        {rows.map((group) => (
          <li>
            <a href={`#kana-${group.row}`}>{group.row}行</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {rows.map((group) => (
    <section aria-labelledby={`kana-${group.row}`}>
      <h2 id={`kana-${group.row}`} class="dd-row">
        {group.row}行
      </h2>
      <ul class="dd-index">
        {group.entries.map((entry) => (
          <li>
            <a href={glossaryHref(entry.id)}>{entry.data.term}</a>
            <p>{entry.data.reading}</p>
            <p>{entry.data.short}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {rows.length === 0 && (
    <div class="dd-empty">
      <p>まだ用語がありません</p>
      <p>
        <a href={href("search/")}>検索する</a>
      </p>
    </div>
  )}
  {entries.length > 0 && (
    <CheckPanel
      slot="check"
      kind="terms"
      title="用語"
      count={entries.length}
      items={entries.map((entry, i) => ({
        label: entry.data.term,
        href: glossaryHref(entry.id),
        index: i + 1,
      }))}
    />
  )}
</ListLayout>
