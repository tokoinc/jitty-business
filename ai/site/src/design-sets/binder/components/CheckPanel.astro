---
import type { CheckPanelProps } from "../../contract";
type Props = CheckPanelProps;
const { kind, title, href, count, items, hidden = false } = Astro.props;
const label = count !== undefined ? `${title} ${count}件` : title;
---

<section
  class={`bi-flag bi-flag--${kind}`}
  aria-labelledby={`flag-${kind}`}
  data-sig="s6-panel"
  hidden={hidden}
>
  <h2 class="bi-flag__h" id={`flag-${kind}`}>
    {href ? <a href={href}>{label}</a> : label}
  </h2>
  {items && (
    <ol class="bi-flag__items">
      {items.map((it) => (
        <li style={`--step:${((it.index ?? 1) - 1) % 5}`}>
          <a href={it.href} aria-current={it.current ? "location" : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ol>
  )}
  {Astro.slots.has("default") && (
    <div class="bi-flag__body">
      <slot />
    </div>
  )}
</section>
