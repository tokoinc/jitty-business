---
import type { PageKind } from "@/design-sets/contract";
import { site } from "@/site.config";
import { documentTitle, isIndexable, themeColor } from "@/utils/seo";
import { href } from "@/utils/url";
import JsonLd from "./JsonLd.astro";

interface Props {
  title: string;
  description: string;
  kind: PageKind;
  noindex?: boolean;
  sample?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, kind, noindex = false, sample = false, ogImage, jsonLd = [] } = Astro.props;
const origin = Astro.site;
if (!origin) throw new Error("astro.config の site が未設定");
const canonical = new URL(Astro.url.pathname, origin);
const docTitle = documentTitle(kind, title, site.name);
const indexable = isIndexable({ mode: site.mode, kind, noindex, sample });
const color = themeColor(site.design.designSet);
const image = new URL(ogImage ?? href("og-default.png"), origin);
const rss = new URL(href("rss.xml"), origin);
const ogType = kind === "article" ? "article" : "website";
---

<title>{docTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta property="og:title" content={docTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={image.href} />
<meta property="og:locale" content={site.locale} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" type="application/rss+xml" title={site.name} href={rss.href} />
<link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
<meta name="theme-color" content={color.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={color.dark} media="(prefers-color-scheme: dark)" />
{!indexable && <meta name="robots" content="noindex" />}
<JsonLd items={jsonLd} />
