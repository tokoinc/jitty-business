---
import type { CheckSlipProps } from "../../contract";
type Props = CheckSlipProps;
const { kind, title, id } = Astro.props;
const tab = { brief: "", conditions: "条件", evidence: "根拠" }[kind];
const H = kind === "brief" ? "h2" : "h3";
---

<section class={`bo-meter bo-meter--${kind}`} id={id} aria-labelledby={`${id}-t`} data-sig="s6">
  {
    tab && (
      <span class="bo-meter__tab" aria-hidden="true">
        {tab}
      </span>
    )
  }
  <div class="bo-meter__head">
    <H class={kind === "brief" ? "bo-meter__tabtitle" : "bo-meter__title"} id={`${id}-t`}>
      {tab && <span class="dd-visually-hidden">{tab}：</span>}
      {kind === "brief" ? <span class="bo-band">{title}</span> : title}
    </H>
    <i class="bo-meter__scale" aria-hidden="true" />
  </div>
  <div class="bo-meter__body">
    <slot />
  </div>
</section>
