---
import { ArticleFace, FaceGrid } from "@/generated/ui";
import { toFace } from "@/utils/cards";
import type { Article, SiteData } from "@/utils/content";
import { nextSteps } from "@/utils/related";

interface Props {
  article: Article;
  data: SiteData;
}
const { article, data } = Astro.props;
const picks = nextSteps(article, data);
const primary = picks.filter((pick) => pick.role === "primary");
const detours = picks.filter((pick) => pick.role === "detour");
---

{picks.length > 0 && (
  <section class="dd-next" aria-labelledby="next-steps">
    <h2 id="next-steps">次に確かめる</h2>
    <FaceGrid layout="next">
      {primary.map((pick, i) => (
        <ArticleFace
          face={toFace(pick.article, data, { purpose: pick.purpose, reason: pick.reason })}
          emphasis="primary"
          index={i + 1}
        />
      ))}
      {detours.length > 0 && (
        <div class="dd-next__side">
          {detours.map((pick, i) => (
            <ArticleFace
              face={toFace(pick.article, data, { purpose: pick.purpose, reason: pick.reason })}
              emphasis="default"
              index={primary.length + i + 1}
            />
          ))}
        </div>
      )}
    </FaceGrid>
  </section>
)}
