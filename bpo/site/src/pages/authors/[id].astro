---
import { render } from "astro:content";
import ListLayout from "@/layouts/ListLayout.astro";
import { getSiteData } from "@/utils/content";
import { formatDate } from "@/utils/dates";
import { AUTHOR_KIND_LABELS } from "@/utils/labels";
import { articlesByAuthor, emptyTargets, faceItems, listCrumbs, relatedTermLinks } from "@/utils/lists";
import { frameProps } from "@/utils/nav";

export async function getStaticPaths() {
  const d = await getSiteData();
  return d.authors.map((author) => ({ params: { id: author.id } }));
}

const id = Astro.params.id;
if (!id) throw new Error("id がない");
const d = await getSiteData();
const author = d.authors.find((item) => item.id === id);
if (!author) throw new Error(`著者がない: ${id}`);
const { Content } = await render(author);
const articles = articlesByAuthor(d, id);
const terms = relatedTermLinks(d, articles);
const specialist = author.data.specialist;
const frame = await frameProps("list");
---

<ListLayout
  title={author.data.name}
  description={author.data.role}
  frame={frame}
  tab="著者"
  crumbs={listCrumbs([{ label: author.data.name }])}
  heading={author.data.name}
  faces={faceItems(articles, d)}
  terms={terms.length > 0 ? terms : undefined}
  empty={emptyTargets(d)}
  noindex={author.data.sample}
>
  {author.data.sample && (
    <p class="dd-sample">サンプルのプロフィールです。実在の人物・組織ではありません。</p>
  )}
  <dl class="dd-facts">
    <dt>種類</dt>
    <dd>{AUTHOR_KIND_LABELS[author.data.kind]}</dd>
    <dt>役割</dt>
    <dd>{author.data.role}</dd>
    {specialist && (
      <>
        <dt>専門分野</dt>
        <dd>{specialist.field}</dd>
        <dt>資格</dt>
        <dd>{specialist.credential}</dd>
        <dt>資格の確認日</dt>
        <dd>
          <time datetime={specialist.verifiedAt}>{formatDate(specialist.verifiedAt)}</time>
        </dd>
      </>
    )}
    {author.data.links.length > 0 && (
      <>
        <dt>リンク</dt>
        <dd>
          <ul>
            {author.data.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </dd>
      </>
    )}
  </dl>
  <div class="dd-prose">
    <Content />
    <h2>記事一覧</h2>
  </div>
</ListLayout>
