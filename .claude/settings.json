{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "mcp__github__create_pull_request",
      "mcp__github__actions_run_trigger",
      "Agent",
      "Workflow"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/budget-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
