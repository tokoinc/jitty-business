---
import type { FrameProps } from "../../contract";
type Props = FrameProps;
const p = Astro.props;
const cur = (b?: boolean) => (b ? "page" : undefined);
// 中身が無いとき has("check") が true になり、空の aside が出る
const checkHtml = ((await Astro.slots.render("check")) ?? "").trim();
// 棚の印は短い棒の列。棚の位置の棒だけ色が付く（CSS が --slot と --i で塗る）
const bars = [1, 2, 3, 4];
---

<div class="il-frame" data-page={p.page} data-sig="s1">
  <a class="dd-skip" href="#main">
    本文へ移動
  </a>
  <header class="il-bar">
    <a class="il-logo" href={p.homeHref} data-logo>
      <span class="il-logo__mark" aria-hidden="true"><i /><i /><i /><b /></span>
      <span class="il-logo__name">{p.siteName}</span>
    </a>
    <a class="il-bar__btn" href={p.searchHref}>
      検索
    </a>
    <button class="il-bar__btn" type="button" popovertarget="il-index">
      索引
    </button>
  </header>
  <nav class="il-tabstrip" aria-label="棚">
    <a class="il-tabstrip__tab" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
      ホーム
    </a>
    {p.shelves.map((s) => (
      <a class="il-tabstrip__tab" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
        {s.label}
      </a>
    ))}
  </nav>
  <nav class="il-index" id="il-index" aria-label="索引" popover>
    <div class="il-index__top">
      <a class="il-logo" href={p.homeHref} data-logo>
        <span class="il-logo__mark" aria-hidden="true"><i /><i /><i /><b /></span>
        <span class="il-logo__name">
          {p.siteName}
          <small>{p.tagline}</small>
        </span>
      </a>
      <ul class="il-shelves" data-sig="s8">
        <li>
          <a class="il-shelf" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
            ホーム
          </a>
        </li>
        {p.shelves.map((s) => (
          <li>
            <a class="il-shelf" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
              <span class="il-bars" aria-hidden="true">
                {bars.map((i) => (
                  <i style={`--i:${i}`} />
                ))}
              </span>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <form class="il-find" role="search" aria-label="索引の検索" action={p.searchHref} method="get">
        <label class="dd-visually-hidden" for="il-q">
          キーワードで検索
        </label>
        <input id="il-q" name="q" type="search" value={p.query ?? ""} placeholder="記事を検索" />
        <button type="submit">探す</button>
      </form>
    </div>
    <div class="il-index__sub">
      <p class="il-index__h" id="il-purpose-h">
        目的から探す
      </p>
      <ul class="il-purpose" aria-labelledby="il-purpose-h">
        {p.purposes.map((x) => (
          <li>
            <a href={x.href} aria-current={cur(x.current)}>
              {x.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="il-utility">
        {p.utility.map((u) => (
          <li>
            <a href={u.href} aria-current={cur(u.current)}>
              {u.label}
            </a>
          </li>
        ))}
        <li>
          <button type="button" popovertarget="dd-settings">
            表示設定
          </button>
        </li>
      </ul>
    </div>
  </nav>
  <div class="il-body">
    <main id="main" class="il-main" tabindex="-1">
      <slot />
      <slot name="after" />
    </main>
    {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
    {checkHtml.length > 0 && <aside class="il-side" aria-label="確かめる" set:html={checkHtml} />}
  </div>
  <footer class="il-footer">
    <span class="il-logo__mark" aria-hidden="true"><i /><i /><i /><b /></span>
    <ul>
      {p.footer.map((f) => (
        <li>
          <a href={f.href}>{f.label}</a>
        </li>
      ))}
    </ul>
  </footer>
</div>
