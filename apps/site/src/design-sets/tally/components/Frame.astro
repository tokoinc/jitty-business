---
import type { FrameProps } from "../../contract";
type Props = FrameProps;
const p = Astro.props;
const cur = (b?: boolean) => (b ? "page" : undefined);
// 中身が無いとき has("check") が true になり、空の aside が出る
const checkHtml = ((await Astro.slots.render("check")) ?? "").trim();
// 棚の印は2×2のマス。棚の番号の数だけ埋める（CSS が --slot と --i で塗る）
const cells = [1, 2, 3, 4];
// ロゴは3×3のマス。塗る位置は parts.css
const logo = [1, 2, 3, 4, 5, 6, 7, 8, 9];
---

<div class="ta-frame" data-page={p.page} data-sig="s1">
  <a class="dd-skip" href="#main">
    本文へ移動
  </a>
  <header class="ta-bar">
    <a class="ta-logo" href={p.homeHref} data-logo>
      <span class="ta-logo__mark" aria-hidden="true">
        {logo.map(() => <i />)}
      </span>
      <span class="ta-logo__name">{p.siteName}</span>
    </a>
    <a class="ta-bar__btn" href={p.searchHref}>
      検索
    </a>
    <button class="ta-bar__btn" type="button" popovertarget="ta-index">
      索引
    </button>
  </header>
  <nav class="ta-tabstrip" aria-label="棚">
    <a class="ta-tabstrip__tab" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
      ホーム
    </a>
    {p.shelves.map((s) => (
      <a class="ta-tabstrip__tab" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
        <span class="ta-cells" aria-hidden="true">
          {cells.map((i) => (
            <i style={`--i:${i}`} />
          ))}
        </span>
        {s.label}
      </a>
    ))}
  </nav>
  <nav class="ta-index" id="ta-index" aria-label="索引" popover>
    <div class="ta-index__top">
      <a class="ta-logo" href={p.homeHref} data-logo>
        <span class="ta-logo__mark" aria-hidden="true">
          {logo.map(() => <i />)}
        </span>
        <span class="ta-logo__name">
          {p.siteName}
          <small>{p.tagline}</small>
        </span>
      </a>
      <ul class="ta-shelves" data-sig="s8">
        <li>
          <a class="ta-shelf" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
            ホーム
          </a>
        </li>
        {p.shelves.map((s) => (
          <li>
            <a class="ta-shelf" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
              <span class="ta-cells" aria-hidden="true">
                {cells.map((i) => (
                  <i style={`--i:${i}`} />
                ))}
              </span>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
      <form class="ta-find" role="search" aria-label="索引の検索" action={p.searchHref} method="get">
        <label class="dd-visually-hidden" for="ta-q">
          キーワードで検索
        </label>
        <input id="ta-q" name="q" type="search" value={p.query ?? ""} placeholder="キーワードで検索" />
        <button type="submit">検索</button>
      </form>
    </div>
    <div class="ta-index__sub">
      <p class="ta-index__h" id="ta-purpose-h">
        目的から探す
      </p>
      <ul class="ta-purpose" aria-labelledby="ta-purpose-h">
        {p.purposes.map((x) => (
          <li>
            <a href={x.href} aria-current={cur(x.current)}>
              {x.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="ta-utility">
        {p.utility.map((u) => (
          <li>
            <a href={u.href} aria-current={cur(u.current)}>
              {u.label}
            </a>
          </li>
        ))}
        <li>
          <button type="button" popovertarget="dd-settings">
            表示設定
          </button>
        </li>
      </ul>
    </div>
  </nav>
  <div class="ta-body">
    <main id="main" class="ta-main" tabindex="-1">
      <slot />
      <slot name="after" />
    </main>
    {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
    {checkHtml.length > 0 && <aside class="ta-side" aria-label="確かめる" set:html={checkHtml} />}
  </div>
  <footer class="ta-footer">
    <span class="ta-logo__mark" aria-hidden="true">
      {logo.map(() => <i />)}
    </span>
    <ul>
      {p.footer.map((f) => (
        <li>
          <a href={f.href}>{f.label}</a>
        </li>
      ))}
    </ul>
  </footer>
</div>
