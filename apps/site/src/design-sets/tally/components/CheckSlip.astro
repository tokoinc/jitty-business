---
import type { CheckSlipProps } from "../../contract";
type Props = CheckSlipProps;
const { kind, title, id } = Astro.props;
const tag = { brief: "", conditions: "条件", evidence: "根拠" }[kind];
const H = kind === "brief" ? "h2" : "h3";
---

<section class={`ta-slip ta-slip--${kind}`} id={id} aria-labelledby={`${id}-t`} data-sig="s6">
  <span class="ta-slip__corner" aria-hidden="true" />
  <div class="ta-slip__head">
    {tag && (
      <span class="ta-slip__tag" aria-hidden="true">
        {tag}
      </span>
    )}
    <H class="ta-slip__title" id={`${id}-t`}>
      {tag && <span class="dd-visually-hidden">{tag}：</span>}
      {title}
    </H>
  </div>
  <div class="ta-slip__body">
    <slot />
  </div>
</section>
