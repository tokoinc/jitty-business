---
import type { PopoverProps } from "../../contract";
type Props = PopoverProps;
const { id, heading } = Astro.props;
---

<div class="sp-pop" id={id} popover role="dialog" aria-labelledby={`${id}-h`} data-sig="s7">
  <p class="sp-pop__tab sp-vlabel" aria-hidden="true">
    用語
  </p>
  <p class="sp-pop__h" id={`${id}-h`}>
    {heading}
  </p>
  <div class="sp-pop__body">
    <slot />
  </div>
  <button type="button" popovertarget={id} popovertargetaction="hide">
    閉じる
  </button>
</div>
