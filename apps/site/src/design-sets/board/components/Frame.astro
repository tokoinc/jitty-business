---
import type { FrameProps } from "../../contract";
type Props = FrameProps;
const p = Astro.props;
const cur = (b?: boolean) => (b ? "page" : undefined);
// 中身が無いとき has("check") が true になり、空の aside が出る
const checkHtml = ((await Astro.slots.render("check")) ?? "").trim();
---

<div class="bo-frame" data-page={p.page} data-sig="s1">
  <a class="dd-skip" href="#main">
    本文へ移動
  </a>
  <header class="bo-bar">
    <a class="bo-logo" href={p.homeHref} data-logo>
      {p.siteName}
    </a>
    <a class="bo-bar__btn" href={p.searchHref}>
      検索
    </a>
    <button class="bo-bar__btn" type="button" popovertarget="bo-index">
      索引
    </button>
  </header>
  <nav class="bo-tabstrip" aria-label="棚">
    <a class="bo-tabstrip__tab" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
      ホーム
    </a>
    {p.shelves.map((s) => (
      <a class="bo-tabstrip__tab" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
        {s.label}
      </a>
    ))}
  </nav>
  <nav class="bo-board" id="bo-index" aria-label="索引" popover>
    <a class="bo-logo" href={p.homeHref} data-logo>
      {p.siteName}
      <small>{p.tagline}</small>
    </a>
    <ul class="bo-switches" data-sig="s8">
      <li>
        <a class="bo-sw" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
          <b aria-hidden="true">00</b>
          ホーム
        </a>
      </li>
      {p.shelves.map((s) => (
        <li>
          <a class="bo-sw" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
            <b aria-hidden="true">{s.number}</b>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="bo-board__h" id="bo-purpose-h">
      目的から探す
    </p>
    <ul class="bo-purpose" aria-labelledby="bo-purpose-h">
      {p.purposes.map((x) => (
        <li>
          <a href={x.href} aria-current={cur(x.current)}>
            {x.label}
          </a>
        </li>
      ))}
    </ul>
    <form class="bo-board__search" role="search" aria-label="索引の検索" action={p.searchHref} method="get">
      <label class="dd-visually-hidden" for="bo-q">
        キーワードで検索
      </label>
      <input id="bo-q" name="q" type="search" value={p.query ?? ""} placeholder="キーワードで検索" />
      <button type="submit">検索</button>
    </form>
    <ul class="bo-utility">
      {p.utility.map((u) => (
        <li>
          <a href={u.href} aria-current={cur(u.current)}>
            {u.label}
          </a>
        </li>
      ))}
      <li>
        <button type="button" popovertarget="dd-settings">
          表示設定
        </button>
      </li>
    </ul>
  </nav>
  <main id="main" class:list={["bo-main", { "bo-panel": p.page === "article" }]} tabindex="-1">
    <slot />
    <slot name="after" />
  </main>
  {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
  {checkHtml.length > 0 && <aside class="bo-col" aria-label="確かめる" set:html={checkHtml} />}
  <footer class="bo-footer">
    <ul>
      {p.footer.map((f) => (
        <li>
          <a href={f.href}>{f.label}</a>
        </li>
      ))}
    </ul>
  </footer>
</div>
