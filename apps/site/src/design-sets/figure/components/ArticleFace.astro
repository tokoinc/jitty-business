---
import { Image } from "astro:assets";
import type { ArticleFaceProps } from "../../contract";
import CategoryMark from "./CategoryMark.astro";
type Props = ArticleFaceProps;
const { face: f, emphasis, headingLevel = 3, index } = Astro.props;
const H = headingLevel === 2 ? "h2" : "h3";
const kind = f.format === "interview" ? "opinion" : f.format;
const num = index !== undefined ? String(index).padStart(2, "0") : "";
---

{kind === "news" ? (
  <article class={`fi-face fi-face--news fi-face--${emphasis}`} data-sig="s4" data-format={f.format}>
    <p class="fi-face__date">
      <time datetime={f.date} data-field="date">
        {f.dateLabel}
      </time>
    </p>
    <div class="fi-face__news-body">
      {f.purposeLabel && <p class="fi-face__type">{f.purposeLabel}</p>}
      <H class="fi-face__title">
        <a href={f.href} data-field="title" data-field-href>
          {f.title}
        </a>
      </H>
      <p class="dd-visually-hidden">
        <span data-field="shelf">{f.shelf.label}</span>・<span data-field="format">{f.formatLabel}</span>
      </p>
      {f.reason && <p class="fi-face__reason">{f.reason}</p>}
    </div>
  </article>
) : (
  <article
    class={`fi-face fi-face--${kind} fi-face--${emphasis}`}
    data-sig="s4"
    data-format={f.format}
    style={`--slot:${f.shelf.slot}`}
  >
    <div class="fi-face__head">
      <span class="fi-face__num" data-field="index" aria-hidden="true">
        {num}
      </span>
      <div class="fi-face__kicker">
        <CategoryMark shelf={f.shelf} context="card" />
        <p class="fi-face__type">
          <span class="fi-face__format" data-field="format">
            {f.formatLabel}
          </span>
          {f.purposeLabel && (
            <>
              <span class="dd-visually-hidden">｜</span>
              <span class="fi-face__purpose">{f.purposeLabel}</span>
            </>
          )}
        </p>
      </div>
    </div>
    {kind === "opinion" && (
      <div class="fi-face__photo" data-photo>
        {f.cover && (
          <Image
            src={f.cover.src}
            alt={f.cover.alt}
            widths={[480, 800]}
            sizes="(max-width: 839px) 100vw, 40vw"
          />
        )}
      </div>
    )}
    <H class="fi-face__title">
      <a href={f.href} data-field="title" data-field-href>
        {f.title}
      </a>
    </H>
    {f.reason && <p class="fi-face__reason">{f.reason}</p>}
    {kind === "guide" && emphasis !== "compact" && <p class="fi-face__lead">{f.description}</p>}
    {kind === "tutorial" && f.steps && (
      <p class="fi-face__steps" data-field="steps">
        <span class="dd-visually-hidden">手順 {f.steps}</span>
        {Array.from({ length: f.steps }, () => (
          <i aria-hidden="true" />
        ))}
      </p>
    )}
    {kind === "comparison" && f.compare && (
      <p class="fi-face__cols" data-field="cols" style={`--cols:${f.compare.items + 1}`}>
        <span class="dd-visually-hidden">
          {f.compare.items}件を{f.compare.axes}項目で比較
        </span>
        {Array.from({ length: f.compare.items + 1 }, () => (
          <i aria-hidden="true" />
        ))}
      </p>
    )}
    {kind === "opinion" && f.speaker && <p class="fi-face__speaker">{f.speaker}</p>}
  </article>
)}
