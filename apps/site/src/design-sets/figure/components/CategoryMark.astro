---
import type { CategoryMarkProps } from "../../contract";
type Props = CategoryMarkProps;
const { shelf, format, context } = Astro.props;
---

<p class={`fi-mark fi-mark--${context}`} style={`--slot:${shelf.slot}`} data-sig="s2">
  <b class="fi-mark__num" aria-hidden="true" />
  <span class="fi-mark__name">
    <span class="dd-visually-hidden">棚：</span>
    <span data-field="shelf">{shelf.label}</span>
  </span>
  {format && (
    <span class="fi-mark__format" aria-hidden="true" data-pagefind-ignore>
      {format.label}
    </span>
  )}
</p>
