---
import SampleCopy from "@/components/common/SampleCopy.astro";
import ListLayout from "@/layouts/ListLayout.astro";
import { site } from "@/site.config";
import { listCrumbs } from "@/utils/lists";
import { frameProps } from "@/utils/nav";
import { href } from "@/utils/url";

const frame = await frameProps("page");
const lead = "広告の関係、表示の方法、編集方針、確認の体制、訂正の受付です。";
---

<ListLayout
  title="広告と編集方針"
  description={lead}
  frame={frame}
  page="page"
  tab="方針"
  crumbs={listCrumbs([{ label: "広告と編集方針" }])}
  heading="広告と編集方針"
  lead={lead}
>
  <SampleCopy />
  <div class="dd-prose">
    <h2>広告関係の種類</h2>
    <ul>
      <li>アフィリエイト広告。{site.disclosure.affiliate}</li>
      <li>記事広告。{site.disclosure.sponsored}</li>
      <li>提供者からの無償提供。{site.disclosure.provided}</li>
    </ul>
    <h2>表示の方法</h2>
    <p>
      関係がある記事は、本文の前にその旨を書きます。報酬の発生するリンクには「広告」と書き、rel="sponsored" を付けます。
    </p>
    <h2>編集方針</h2>
    <p>広告の有無で、結論や確認の範囲は変えません。紹介する条件は、確認した日付のものです。</p>
    <h2>確認の体制</h2>
    <p>
      記事には、確認した人の実際の役割、確認日、確認した範囲を出します。資格を確認していない人を、専門家の監修として書きません。
    </p>
    <h2>訂正の受付</h2>
    <p>
      誤りは、直した内容と日時と理由を記事の履歴に残します。<a href={href("contact/")}>お問い合わせ</a>で訂正を受け付けます。
    </p>
  </div>
</ListLayout>
