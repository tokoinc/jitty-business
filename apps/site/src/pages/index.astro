---
import { QUESTIONS } from "@site/data/questions";
import { ArticleFace, CheckPanel, EndMark, FaceGrid, Frame, SectionHeading } from "@/generated/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/site.config";
import { toFace } from "@/utils/cards";
import { getSiteData } from "@/utils/content";
import { formatDate } from "@/utils/dates";
import { FORMAT_LABELS } from "@/utils/labels";
import { articlesOnShelf, episodesOf, shelvesWithArticles } from "@/utils/lists";
import { frameProps } from "@/utils/nav";
import { homeJsonLd } from "@/utils/seo";
import { articleHref, categoryHref, href, seriesHref } from "@/utils/url";

const d = await getSiteData();
const nav = await frameProps("home", { home: true });
const question = QUESTIONS[0];
const tagLabel = new Map(d.tags.map((tag) => [tag.id, tag.data.label]));
const mentions = (query: string, article: (typeof d.articles)[number]) =>
  article.data.title.includes(query) ||
  article.data.description.includes(query) ||
  article.data.tags.some((tag) => (tagLabel.get(tag.id) ?? "").includes(query));

const lead =
  d.articles.find((article) => article.data.featured) ??
  d.articles.find((article) => article.data.format !== "news");
const related = question
  ? d.articles.filter((article) => article !== lead && mentions(question.query, article)).slice(0, 2)
  : [];
const latest = d.articles.filter((article) => article !== lead && article.data.format !== "news").slice(0, 6);
const news = d.articles.filter((article) => article !== lead && article.data.format === "news").slice(0, 3);
const seriesBlocks = d.series.flatMap((series) => {
  const episodes = episodesOf(d, series.id);
  return episodes.length ? [{ series, episodes }] : [];
});
const recent = d.articles
  .flatMap((article) => (article.data.lastVerifiedAt ? [{ article, day: article.data.lastVerifiedAt }] : []))
  .sort((a, b) => b.day.localeCompare(a.day))
  .slice(0, 3);
const shelves = shelvesWithArticles(d);
const sections = [latest.length > 0 ? "latest" : "", news.length > 0 ? "news" : ""].filter(Boolean);
const sectionIndex = (id: string) => sections.indexOf(id) + 1;
const origin = Astro.site;
if (!origin) throw new Error("astro.config の site が未設定");
const homeUrl = new URL(Astro.url.pathname, origin).href;
---

<BaseLayout
  title={site.name}
  description={site.description}
  page="home"
  jsonLd={homeJsonLd({
    name: site.name,
    description: site.description,
    url: homeUrl,
    organizationName: site.organization.name,
    logoUrl: new URL(href("favicon.svg"), origin).href,
  })}
>
  <Frame {...nav}>
    <h1 class="dd-visually-hidden">ホーム</h1>
    <p class="dd-page-mark" style="--slot:1" data-sig="s2">
      ホーム
    </p>
    {(lead || related.length > 0) && (
      <div class="dd-home-lead">
        {lead && <ArticleFace face={toFace(lead, d)} emphasis="lead" headingLevel={2} index={1} />}
        {question && related.length > 0 && (
          <section class="dd-home-q" aria-labelledby="home-question">
            <p class="dd-home-q__kicker">今週の問い</p>
            <h2 id="home-question">{question.label}</h2>
            <ul>
              {related.map((article) => (
                <li>
                  <a href={articleHref(article.id)}>
                    <span class="dd-home-q__type">{FORMAT_LABELS[article.data.format]}</span>
                    {article.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
    {latest.length > 0 && (
      <>
        <SectionHeading id="latest" index={sectionIndex("latest")} context="section" label="新着">
          新しい記事
        </SectionHeading>
        <FaceGrid layout="latest">
          {latest.map((article, i) => (
            <ArticleFace face={toFace(article, d)} emphasis="default" index={i + 1} />
          ))}
        </FaceGrid>
      </>
    )}
    {news.length > 0 && (
      <>
        <SectionHeading id="news" index={sectionIndex("news")} context="section" label="短報">
          確認された変更
        </SectionHeading>
        {news.map((article, i) => (
          <ArticleFace face={toFace(article, d)} emphasis="default" index={i + 1} />
        ))}
      </>
    )}
    {shelves.length > 0 && (
      <>
        <EndMark />
        <nav class="dd-shelves" aria-labelledby="home-shelves">
          <h2 id="home-shelves">棚から探す</h2>
          <ul>
            {shelves.map((shelf) => (
              <li>
                <a href={categoryHref(shelf.id)}>
                  {shelf.data.label}{" "}
                  <span class="dd-shelves__count">{articlesOnShelf(d, shelf.id).length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    )}
    <Fragment slot="check">
      {site.features.resumeReading && (
        <CheckPanel kind="reading" title="読みかけ" hidden>
          <p>
            <a data-reading data-base={site.base} href={site.base}>
              読みかけ
            </a>
          </p>
        </CheckPanel>
      )}
      {seriesBlocks.length > 0 && (
        <CheckPanel kind="series" title="連載">
          {seriesBlocks.map(({ series, episodes }) => {
            const order = episodes[episodes.length - 1]?.data.series?.order;
            return (
              <p>
                <a href={seriesHref(series.id)}>{series.data.title}</a>
                {series.data.total && order ? `　第${order}回／全${series.data.total}回` : ""}
              </p>
            );
          })}
        </CheckPanel>
      )}
      {recent.length > 0 && (
        <CheckPanel
          kind="recent"
          title="最近確認した記事"
          items={recent.map(({ article, day }) => ({
            label: `${formatDate(day)}　${article.data.title}`,
            href: articleHref(article.id),
          }))}
        />
      )}
    </Fragment>
  </Frame>
  {site.features.resumeReading && <script>
    import "@/scripts/reading-home";
  </script>}
</BaseLayout>
