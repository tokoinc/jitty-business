---
const KINDS = { note: "注記", warning: "注意", tip: "補足" } as const;
interface Props {
  kind: keyof typeof KINDS;
  title?: string;
}
const { kind, title } = Astro.props;
const articleId = Astro.locals.dd?.article.id ?? "unknown";
if (!(kind in KINDS)) {
  throw new Error(`articles/${articleId} の <Callout>: kind は note / warning / tip`);
}
---

<div class="dd-callout" data-kind={kind} role="note">
  <p class="dd-callout__label">{KINDS[kind]}</p>
  {title && <p class="dd-callout__title">{title}</p>}
  <div class="dd-callout__body">
    <slot />
  </div>
</div>
