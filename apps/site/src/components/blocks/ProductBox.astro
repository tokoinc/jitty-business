---
import { getEntry } from "astro:content";
import Conditions from "./Conditions.astro";

const KIND_LABEL = {
  product: "商品",
  service: "サービス",
  "financial-service": "金融サービス",
} as const;
const USE_LABEL = { official: "公式サイト", editorial: "解説" } as const;

interface Props {
  id: string;
}
const { id } = Astro.props;
const ctx = Astro.locals.dd!;
const fail = (message: string): never => {
  throw new Error(`articles/${ctx.article.id} の <ProductBox id="${id}">: ${message}`);
};
if (!ctx.article.data.products.some((product) => product.id === id)) {
  fail(`product "${id}" を frontmatter の products に宣言する`);
}
const entry = await getEntry("products", id);
if (!entry) {
  throw new Error(
    `articles/${ctx.article.id} の <ProductBox id="${id}">: product "${id}" が products にない`,
  );
}
const product = entry.data;
---

<section class="dd-product" aria-labelledby={`product-${id}-name`}>
  <h3 id={`product-${id}-name`} class="dd-product__name">
    <span class="dd-product__kind">{KIND_LABEL[product.kind]}</span>
    {product.name}
  </h3>
  <p class="dd-product__provider">{product.provider}</p>
  <p>{product.description}</p>
  <Conditions id={`product-${id}`} title={`${product.name}の料金と条件`} product={id} />
  <ul class="dd-product__links">
    {product.links.map((link) => {
      const ad = link.relation === "affiliate" || link.relation === "sponsored";
      return (
        <li>
          <a
            href={link.url}
            rel={ad ? "sponsored noopener" : undefined}
            target={ad ? "_blank" : undefined}
            data-ad={ad ? link.relation : undefined}
          >
            {USE_LABEL[link.use]}
            {ad && <span class="dd-product__ad">広告</span>}
            {ad && <span class="dd-visually-hidden">（新しいタブで開きます）</span>}
          </a>
        </li>
      );
    })}
  </ul>
</section>
