<div id="dd-settings" class="dd-settings" popover>
  <h2>表示設定</h2>
  <fieldset>
    <legend>明暗</legend>
    <label>
      <input type="radio" name="theme" value="system" checked />
      端末に合わせる
    </label>
    <label>
      <input type="radio" name="theme" value="light" />
      ライト
    </label>
    <label>
      <input type="radio" name="theme" value="dark" />
      ダーク
    </label>
  </fieldset>
  <fieldset>
    <legend>文字サイズ</legend>
    <label>
      <input type="radio" name="font" value="sm" />小
    </label>
    <label>
      <input type="radio" name="font" value="md" checked />中
    </label>
    <label>
      <input type="radio" name="font" value="lg" />大
    </label>
  </fieldset>
  <button type="button" popovertarget="dd-settings" popovertargetaction="hide">
    閉じる
  </button>
  <p>設定はこの端末のブラウザだけに保存されます</p>
</div>
<script>
  import "@/scripts/settings";
</script>
