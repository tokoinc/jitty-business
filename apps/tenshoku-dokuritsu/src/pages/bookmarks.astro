---
import FaceTemplates from "@/components/common/FaceTemplates.astro";
import ListLayout from "@/layouts/ListLayout.astro";
import { site } from "@/site.config";
import { listCrumbs } from "@/utils/lists";
import { frameProps } from "@/utils/nav";

const frame = await frameProps("list", { current: "bookmarks" });
const lead = site.features.bookmarks
  ? "この端末のブラウザだけに保存されます。あとで読むは200件まで、続きの位置は50記事までで、180日を過ぎると消えます。"
  : "この端末のブラウザだけに保存されます。";
---

<ListLayout
  title="保存した記事"
  description={lead}
  frame={frame}
  tab="保存"
  crumbs={listCrumbs([{ label: "保存した記事" }])}
  heading="保存した記事"
  lead={lead}
  noindex
>
  {site.features.bookmarks ? (
    <>
      <div id="dd-bookmarks" data-bookmarks data-base={site.base}>
        <p>保存した記事は、JavaScript が動くブラウザで表示します。</p>
      </div>
      <FaceTemplates />
    </>
  ) : (
    <p>保存した記事の機能は、いまは使っていません。</p>
  )}
</ListLayout>
{site.features.bookmarks && <script>
  import "@/scripts/bookmarks";
</script>}
