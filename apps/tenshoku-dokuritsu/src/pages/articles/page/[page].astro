---
import NewestArticles from "@/components/lists/NewestArticles.astro";
import { site } from "@/site.config";
import { getSiteData } from "@/utils/content";
import { pageSlice } from "@/utils/paginate";

export async function getStaticPaths() {
  const d = await getSiteData();
  const { total } = pageSlice(d.articles, 1, site.articlesPerPage);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);
---

<NewestArticles page={page} />
