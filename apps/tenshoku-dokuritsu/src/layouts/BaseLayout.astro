---
import "@/styles/global.css";
import Head from "@/components/seo/Head.astro";
import SettingsPanel from "@/components/common/SettingsPanel.astro";
import InspectPanel from "@/components/common/InspectPanel.astro";
import { DESIGN } from "@/generated/ui";
import { site } from "@/site.config";
import type { PageKind } from "@/design-sets/contract";

interface Props {
  title: string;
  description: string;
  page: PageKind;
  noindex?: boolean;
  sample?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  /** スタイルガイドなど、ページ全体を Pagefind の対象外にする */
  pagefindIgnore?: boolean;
}
const {
  title,
  description,
  page,
  noindex = false,
  sample = false,
  ogImage,
  jsonLd = [],
  pagefindIgnore = false,
} = Astro.props;
const prefKey = `${site.storage.namespace}:preferences`;
---

<!doctype html>
<html
  lang="ja"
  data-design-set={DESIGN.set}
  data-finish={DESIGN.finish}
  data-page={page}
  data-storage-ns={site.storage.namespace}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ prefKey }}>
      try {
        const v = JSON.parse(localStorage.getItem(prefKey) || "null");
        if (v && v.version === 1) {
          if (v.theme === "light" || v.theme === "dark") document.documentElement.dataset.theme = v.theme;
          if (["sm", "md", "lg"].includes(v.fontScale))
            document.documentElement.dataset.fontScale = v.fontScale;
        }
      } catch {
        /* localStorage が使えないときは保存済みの設定を適用しない */
      }
    </script>
    <Head
      title={title}
      description={description}
      kind={page}
      noindex={noindex}
      sample={sample}
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body data-pagefind-ignore={pagefindIgnore ? true : undefined}>
    <slot />
    <SettingsPanel />
    <div id="dd-notice" class="dd-notice" role="status" aria-live="polite"></div>
    {site.inspect && <InspectPanel />}
  </body>
</html>
