---
interface Props {
  points: string[];
}
const { points } = Astro.props;
const articleId = Astro.locals.dd?.article.id ?? "unknown";
if (!points?.length) throw new Error(`articles/${articleId}: <Summary> に points が必要`);
---

<section class="dd-summary">
  <h2>要点</h2>
  <ul>
    {points.map((point) => (
      <li>{point}</li>
    ))}
  </ul>
</section>
