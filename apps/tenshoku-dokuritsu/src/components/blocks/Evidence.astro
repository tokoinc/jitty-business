---
import { CheckSlip } from "@/generated/ui";
import { formatDate } from "@/utils/dates";

interface Props {
  id: string;
  ids: string[];
  note: string;
  method?: string;
}
const { id, ids, note, method } = Astro.props;
const ctx = Astro.locals.dd!;
const fail = (message: string): never => {
  throw new Error(`articles/${ctx.article.id} の <Evidence id="${id}">: ${message}`);
};
if (!ids?.length) fail("ids が必要");
if (!note) fail("note が必要");
const declared = ctx.article.data.sources.map((source) => source.id);
for (const sourceId of ids) {
  if (!declared.includes(sourceId)) {
    fail(`source "${sourceId}" を frontmatter の sources に宣言する`);
  }
}
const num = (sourceId: string) => declared.indexOf(sourceId) + 1;
const items = ids.map((sourceId) => {
  const entry = ctx.data.sources.find((source) => source.id === sourceId);
  if (!entry) {
    throw new Error(
      `articles/${ctx.article.id} の <Evidence id="${id}">: 情報源 "${sourceId}" が sources にない`,
    );
  }
  return {
    id: sourceId,
    n: num(sourceId),
    title: entry.data.title,
    publisher: entry.data.publisher,
    checkedAt: entry.data.checkedAt,
  };
});
---

<div data-check="evidence" id={id} data-title={note}>
  <CheckSlip kind="evidence" id={`${id}-slip`} title={note}>
    <ul>
      {items.map((item) => (
        <li>
          <a href={`#src-${item.id}`}>[{item.n}]</a>
          {item.title}
          <span>{item.publisher}</span>
          <time datetime={item.checkedAt}>{formatDate(item.checkedAt)}</time>
        </li>
      ))}
    </ul>
    {method && <p>確認方法：{method}</p>}
  </CheckSlip>
</div>
