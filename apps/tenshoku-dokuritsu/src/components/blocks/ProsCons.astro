---
interface Props {
  pros: string[];
  cons: string[];
}
const { pros, cons } = Astro.props;
const articleId = Astro.locals.dd?.article.id ?? "unknown";
if (!pros?.length || !cons?.length) {
  throw new Error(`articles/${articleId}: <ProsCons> に pros と cons が必要`);
}
const base = `proscons-${articleId}`;
---

<div class="dd-proscons">
  <section aria-labelledby={`${base}-pros`}>
    <h3 id={`${base}-pros`}>よい点</h3>
    <ul>
      {pros.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
  <section aria-labelledby={`${base}-cons`}>
    <h3 id={`${base}-cons`}>注意する点</h3>
    <ul>
      {cons.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
</div>
