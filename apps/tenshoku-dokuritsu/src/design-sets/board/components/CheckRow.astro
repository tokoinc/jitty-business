---
import type { CheckRowProps } from "../../contract";
type Props = CheckRowProps;
const { items } = Astro.props;
---

<nav class="bo-checkrow" aria-label="この記事で確かめる">
  {
    items.map((item) => (
      <a class="bo-checkrow__key" href={item.href}>
        {item.count !== undefined ? `${item.label} ${item.count}` : item.label}
      </a>
    ))
  }
</nav>
