---
import type { FrameProps } from "../../contract";
type Props = FrameProps;
const p = Astro.props;
const cur = (b?: boolean) => (b ? "page" : undefined);
// 中身が無いとき has("check") が true になり、空の aside が出る
const checkHtml = ((await Astro.slots.render("check")) ?? "").trim();
---

<div class="bi-frame" data-page={p.page} data-sig="s1" style={`--g-cut:${p.shelves.length <= 3 ? 3 : 5}`}>
  <a class="dd-skip" href="#main">
    本文へ移動
  </a>
  <header class="bi-bar">
    <a class="bi-logo" href={p.homeHref} data-logo>
      {p.siteName}
    </a>
    <a class="bi-bar__btn" href={p.searchHref}>
      検索
    </a>
    <button class="bi-bar__btn" type="button" popovertarget="bi-index">
      索引
    </button>
  </header>
  <nav class="bi-tabstrip" aria-label="カテゴリ">
    <a class="bi-tabstrip__tab" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
      ホーム
    </a>
    {p.shelves.map((s) => (
      <a class="bi-tabstrip__tab" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
        {s.label}
      </a>
    ))}
  </nav>
  <nav class="bi-rail" id="bi-index" aria-label="索引" popover>
    <a class="bi-logo" href={p.homeHref} data-logo>
      {p.siteName}
      <small>{p.tagline}</small>
    </a>
    <ul class="bi-claws" data-sig="s8">
      <li>
        <a class="bi-claw" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
          ホーム
        </a>
      </li>
      {p.shelves.map((s) => (
        <li>
          <a class="bi-claw" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="bi-rail__h" id="bi-purpose-h">
      目的から探す
    </p>
    <ul class="bi-purpose" aria-labelledby="bi-purpose-h">
      {p.purposes.map((x) => (
        <li>
          <a href={x.href} aria-current={cur(x.current)}>
            {x.label}
          </a>
        </li>
      ))}
    </ul>
    <form class="bi-rail-search" role="search" aria-label="索引の検索" action={p.searchHref} method="get">
      <label class="dd-visually-hidden" for="bi-q">
        キーワードで検索
      </label>
      <input id="bi-q" name="q" type="search" value={p.query ?? ""} placeholder="キーワードで検索" />
      <button type="submit">検索</button>
    </form>
    <ul class="bi-utility">
      {p.utility.map((u) => (
        <li>
          <a href={u.href} aria-current={cur(u.current)}>
            {u.label}
          </a>
        </li>
      ))}
      <li>
        <button type="button" popovertarget="dd-settings">
          表示設定
        </button>
      </li>
    </ul>
  </nav>
  <main id="main" class="bi-sheet" tabindex="-1">
    <slot />
    <slot name="after" />
  </main>
  {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
  {checkHtml.length > 0 && <aside class="bi-flags" aria-label="確かめる" set:html={checkHtml} />}
  <footer class="bi-footer">
    <ul>
      {p.footer.map((f) => (
        <li>
          <a href={f.href}>{f.label}</a>
        </li>
      ))}
    </ul>
  </footer>
</div>
