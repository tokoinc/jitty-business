---
import ListLayout from "@/layouts/ListLayout.astro";
import { site } from "@/site.config";
import { listCrumbs } from "@/utils/lists";
import { frameProps } from "@/utils/nav";
import { href } from "@/utils/url";

const frame = await frameProps("page");
const lead = "50代からの次の働き方を、比べて、選んで、準備するメディアです。";
---

<ListLayout
  title="このサイトについて"
  description={lead}
  frame={frame}
  page="page"
  tab="サイト"
  crumbs={listCrumbs([{ label: "このサイトについて" }])}
  heading="このサイトについて"
  lead={lead}
>
  <div class="dd-prose">
    <p>
      {site.name}は、早期退職・役職定年をきっかけに、会社の外での働き方を考える管理職・専門職のためのサイトです。独立と転職を同じ基準で比べ、次の働き方を選んで準備するための公開情報を整理します。
    </p>
    <p>運営主体の正式名称は、独立か、転職か。 by JITTY BUSINESS です。</p>
    <p>
      編集者は、当事者の体験を代弁しません。公開されている情報を整理します。類似する書籍や、ほかの媒体とは関係ありません。
    </p>
    <p>
      <a href={href("editorial-policy/")}>編集方針</a>、<a href={href("disclaimer/")}>免責</a>、<a href={href("disclosure/")}>広告</a>、<a href={href("privacy/")}>プライバシー</a>、<a href={href("contact/")}>お問い合わせ</a>
    </p>
  </div>
</ListLayout>
