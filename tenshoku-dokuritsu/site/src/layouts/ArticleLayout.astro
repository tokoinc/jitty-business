---
import BaseLayout from "./BaseLayout.astro";
import { Frame, CategoryMark, CheckSlip, CheckRow, CheckPanel, EndMark } from "@/generated/ui";
import { frameProps } from "@/utils/nav";
import { checkedBucket, dateTimeAttr, formatDate, formatDateTime, isOverdue } from "@/utils/dates";
import { FORMAT_LABELS, INTENT_LABELS } from "@/utils/labels";
import { profileOf, type Article, type SiteData } from "@/utils/content";
import { site } from "@/site.config";
import { articleJsonLd } from "@/utils/seo";
import { decodeAttr } from "@/utils/text";
import { authorHref, categoryHref, href, seriesHref } from "@/utils/url";
import ArticleFoot from "@/components/article/ArticleFoot.astro";
import NextSteps from "@/components/article/NextSteps.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import SaveButton from "@/components/common/SaveButton.astro";

interface Props {
  article: Article;
  data: SiteData;
  h2: { id: string; text: string }[];
}
const { article, data, h2 } = Astro.props;
const a = article.data;
const body = await Astro.slots.render("default");
const marks = [...body.matchAll(/data-check="(conditions|evidence)" id="([^"]+)" data-title="([^"]*)"/g)];
// 拾った属性値はエスケープ済み。表示のときに Astro がもう一度エスケープするので戻す
const conditions = marks
  .filter((m) => m[1] === "conditions")
  .map((m) => ({ label: decodeAttr(m[3] ?? ""), href: `#${decodeAttr(m[2] ?? "")}` }));
const evidence = marks
  .filter((m) => m[1] === "evidence")
  .map((m) => ({ label: decodeAttr(m[3] ?? ""), href: `#${decodeAttr(m[2] ?? "")}` }));
const cat = data.categories.find((c) => c.id === a.category.id);
if (!cat) throw new Error(`articles/${article.id}: 棚 ${a.category.id} がない`);
const nav = await frameProps("article", { shelf: cat.id });
const shelf = {
  id: cat.id,
  label: cat.data.label,
  slot: cat.data.tabSlot ?? 1,
  number: String(cat.data.order).padStart(2, "0"),
};
const stale = profileOf(article, data.categories) === "sensitive" && isOverdue(a.reviewDueAt);
const ads = [
  a.commercial.sponsored ? site.disclosure.sponsored : "",
  a.commercial.affiliate ? site.disclosure.affiliate : "",
  a.commercial.provided ? site.disclosure.provided : "",
].filter((item) => item.length > 0);
const author = data.authors.find((item) => item.id === a.author.id);
if (!author) throw new Error(`articles/${article.id}: 著者 ${a.author.id} がない`);
const origin = Astro.site;
if (!origin) throw new Error("astro.config の site が未設定");
const pageUrl = new URL(Astro.url.pathname, origin).href;
const articleLd = articleJsonLd({
  format: a.format,
  title: a.title,
  description: a.description,
  publishedAt: a.publishedAt,
  updatedAt: a.updatedAt,
  author: {
    name: author.data.name,
    kind: author.data.kind,
    url: new URL(authorHref(author.id), origin).href,
  },
  pageUrl,
  imageUrl: new URL(a.cover ? a.cover.src.src : href("og-default.png"), origin).href,
  publisherName: site.organization.name,
  publisherLogo: new URL(href("favicon.svg"), origin).href,
});
const seriesEntry = a.series ? data.series.find((item) => item.id === a.series?.id.id) : undefined;
const formatLabel = FORMAT_LABELS[a.format];
const intentLabel = INTENT_LABELS[a.intent].short;
const faceDate = a.format === "news" && a.eventAt ? a.eventAt : a.publishedAt;
const dateLabel = formatDate(faceDate);
const checked = checkedBucket(a.lastVerifiedAt);
---

<BaseLayout
  title={a.title}
  description={a.description}
  page="article"
  noindex={a.noindex}
  sample={a.sample}
  ogImage={a.cover ? a.cover.src.src : undefined}
  jsonLd={[articleLd]}
>
  <Frame {...nav}>
    <CategoryMark shelf={shelf} format={{ id: a.format, label: FORMAT_LABELS[a.format] }} context="sheet" />
    <Breadcrumbs
      items={[
        { label: "TOP", href: href("") },
        { label: cat.data.label, href: categoryHref(cat.id) },
        { label: a.title },
      ]}
    />
    {ads.length > 0 && <p class="dd-ad">{ads.join(" ")}</p>}
    {a.sample && (
      <p class="dd-sample">サンプル記事です。人物・数値・サービスは架空で、実際の条件ではありません。</p>
    )}
    {stale && (
      <p class="dd-stale" role="note">
        この記事の条件は再確認中です。金額・金利は表示を控えています。最新の条件は公式の案内で確認してください。
      </p>
    )}
    <header class="dd-article-head">
      <p class="dd-kicker">
        {formatLabel}
        {a.lastVerifiedAt && (
          <>
            ｜最終確認日 <time datetime={a.lastVerifiedAt}>{formatDate(a.lastVerifiedAt)}</time>
          </>
        )}
      </p>
      {/* 見出し・リード。同じページの data-pagefind-body は Pagefind が1件にまとめる */}
      <div data-pagefind-body>
        <h1 class="dd-title" data-pagefind-meta="title">
          {a.title}
        </h1>
        <span hidden data-pagefind-meta={`format:${a.format}`}></span>
        <span hidden data-pagefind-meta={`formatLabel:${formatLabel}`}></span>
        <span hidden data-pagefind-meta={`shelf:${shelf.label}`}></span>
        <span hidden data-pagefind-meta={`shelfSlot:${shelf.slot}`}></span>
        <span hidden data-pagefind-meta={`date:${dateLabel}`}></span>
        {a.steps != null && <span hidden data-pagefind-meta={`steps:${a.steps}`}></span>}
        {a.compare && <span hidden data-pagefind-meta={`cols:${a.compare.items + 1}`}></span>}
        <span hidden data-pagefind-filter={`shelf:${shelf.label}`}></span>
        <span hidden data-pagefind-filter={`format:${formatLabel}`}></span>
        <span hidden data-pagefind-filter={`purpose:${intentLabel}`}></span>
        {checked && <span hidden data-pagefind-filter={`checked:${checked}`}></span>}
        <p class="dd-lead">{a.description}</p>
      </div>
      <p class="dd-meta">
        <a href={authorHref(author.id)}>{author.data.name}</a>
        ｜公開 <time datetime={dateTimeAttr(a.publishedAt)}>{formatDate(a.publishedAt)}</time>
        {a.updatedAt && (
          <>
            ｜更新 <time datetime={dateTimeAttr(a.updatedAt)}>{formatDate(a.updatedAt)}</time>
          </>
        )}
        {a.format === "news" && a.eventAt && (
          <>
            ｜発生 <time datetime={dateTimeAttr(a.eventAt)}>{formatDateTime(a.eventAt)}</time>
          </>
        )}
        {a.format === "news" && a.asOf && (
          <>
            ｜確認時点 <time datetime={dateTimeAttr(a.asOf)}>{formatDateTime(a.asOf)}</time>
          </>
        )}
        {seriesEntry && (
          <>
            ｜<a href={seriesHref(seriesEntry.id)}>{seriesEntry.data.title}</a>（第{a.series?.order}回）
          </>
        )}
      </p>
      {site.features.bookmarks && <SaveButton id={article.id} />}
      {site.features.resumeReading && <p class="dd-resume" data-resume hidden></p>}
    </header>
    {a.brief && (
      <div data-pagefind-body>
        <CheckSlip kind="brief" id="brief" title="この記事で分かること">
          <dl>
            <dt>分かること</dt>
            <dd>
              <ul>
                {a.brief.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </dd>
            {a.brief.audience && (
              <>
                <dt>対象</dt>
                <dd>{a.brief.audience}</dd>
              </>
            )}
            {a.brief.scope && (
              <>
                <dt>範囲</dt>
                <dd>{a.brief.scope}</dd>
              </>
            )}
          </dl>
        </CheckSlip>
      </div>
    )}
    <CheckRow
      items={[
        { label: "目次", href: "#toc" },
        ...(conditions.length ? [{ label: "条件", href: conditions[0].href, count: conditions.length }] : []),
        ...(a.sources.length ? [{ label: "根拠", href: "#sources", count: a.sources.length }] : []),
      ]}
    />
    <nav id="toc" class="dd-toc" aria-label="目次">
      <ol>
        {h2.map((heading) => (
          <li>
            <a href={`#${heading.id}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
    {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
    <div class="dd-prose" data-pagefind-body data-article={article.id} set:html={body} />
    <EndMark />
    <Fragment slot="after">
      <NextSteps article={article} data={data} />
      <ArticleFoot article={article} data={data} />
    </Fragment>
    <Fragment slot="check">
      <CheckPanel
        kind="toc"
        title="目次"
        items={h2.map((heading, i) => ({
          label: `${String(i + 1).padStart(2, "0")} ${heading.text}`,
          href: `#${heading.id}`,
          index: i + 1,
        }))}
      />
      {conditions.length > 0 && (
        <CheckPanel kind="conditions" title="条件" count={conditions.length} items={conditions} />
      )}
      {a.sources.length > 0 && (
        <CheckPanel
          kind="evidence"
          title="根拠"
          count={a.sources.length}
          href="#sources"
          items={evidence.length > 0 ? evidence : undefined}
        >
          {a.lastVerifiedAt && <p>最終確認日 {formatDate(a.lastVerifiedAt)}</p>}
        </CheckPanel>
      )}
    </Fragment>
  </Frame>
  <script>
    import "@/scripts/reader";
    import "@/scripts/toc";
  </script>
</BaseLayout>
