---
import type { SectionHeadingProps } from "../../contract";
type Props = SectionHeadingProps;
const { id, index, context, label } = Astro.props;
---

<div
  class={`bi-divider bi-divider--${context}`}
  style={`--step:${(index - 1) % 5};--step3:${(index - 1) % 3}`}
  data-sig="s3"
>
  <span class="bi-divider__num" aria-hidden="true">
    {label ?? String(index).padStart(2, "0")}
  </span>
  <h2 id={id}>
    <slot />
  </h2>
</div>
