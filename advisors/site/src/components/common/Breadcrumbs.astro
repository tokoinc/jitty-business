---
import JsonLd from "@/components/seo/JsonLd.astro";
import { breadcrumbJsonLd } from "@/utils/seo";

interface Item {
  label: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const origin = Astro.site;
if (!origin) throw new Error("astro.config の site が未設定");
const pageUrl = new URL(Astro.url.pathname, origin).href;
---

<nav class="dd-crumbs" aria-label="パンくず">
  <ol>
    {items.map((item, i) => {
      const current = i === items.length - 1;
      return (
        <li>
          {current || !item.href ? (
            <span aria-current={current ? "page" : undefined}>{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<JsonLd items={[breadcrumbJsonLd(items, pageUrl)]} />
