---
import { ArticleFace } from "@/generated/ui";
import { toFace } from "@/utils/cards";
import { isPublished } from "@/utils/content";

interface Props {
  to: string;
}
const { to } = Astro.props;
const ctx = Astro.locals.dd!;
const target = ctx.data.all.find((article) => article.id === to);
if (!target || !isPublished(target)) {
  throw new Error(`articles/${ctx.article.id} の <LinkCard to="${to}">: 公開中の記事を指定する`);
}
---

<div class="dd-linkcard">
  <ArticleFace face={toFace(target, ctx.data)} emphasis="compact" index={1} />
</div>
