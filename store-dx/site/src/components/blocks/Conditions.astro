---
import { getEntry } from "astro:content";
import { CheckSlip } from "@/generated/ui";
import { formatPrice, formatRate } from "@/utils/numbers";
import { formatDate, isOverdue } from "@/utils/dates";
import { site } from "@/site.config";

interface Row {
  label: string;
  value: string;
  source?: string;
  note?: string;
}
interface Props {
  id: string;
  title: string;
  rows?: Row[];
  product?: string;
}
const { id, title, rows = [], product } = Astro.props;
const ctx = Astro.locals.dd!;
const declared = ctx.article.data.sources.map((s) => s.id);
const fail = (m: string): never => {
  throw new Error(`articles/${ctx.article.id} の <Conditions id="${id}">: ${m}`);
};
if (!rows.length && !product) fail("rows または product が必要");
for (const r of rows) {
  if (r.source && !declared.includes(r.source)) {
    fail(`source "${r.source}" を frontmatter の sources に宣言する`);
  }
}
let list = rows;
let hidden = false;
if (product) {
  if (!ctx.article.data.products.some((p) => p.id === product)) {
    fail(`product "${product}" を frontmatter の products に宣言する`);
  }
  const entry = await getEntry("products", product);
  if (!entry) {
    throw new Error(
      `articles/${ctx.article.id} の <Conditions id="${id}">: product "${product}" が products にない`,
    );
  }
  hidden = isOverdue(entry.data.reviewDueAt) && site.editorial.staleNumbers === "hide";
  list = [
    ...entry.data.prices.map((x) => ({
      label: x.label,
      value: hidden ? "再確認中" : formatPrice(x),
      note: `${formatDate(x.asOf)}時点`,
      source: x.source.id,
    })),
    ...entry.data.rates.map((x) => ({
      label: x.label,
      value: hidden ? "再確認中" : formatRate(x),
      note: [x.condition, `${formatDate(x.asOf)}時点`].filter(Boolean).join("・"),
      source: x.source.id,
    })),
    ...entry.data.conditions.map((x) => ({
      label: x.label,
      value: x.value,
      note: [x.audience, x.period, x.excludes && `対象外：${x.excludes}`].filter(Boolean).join("・"),
      source: x.source.id,
    })),
  ];
}
const num = (s?: string) => (s ? declared.indexOf(s) + 1 : 0);
---

<div data-check="conditions" id={id} data-title={title}>
  <CheckSlip kind="conditions" id={`${id}-slip`} title={title}>
    <table class="dd-cond">
      <tbody>
        {list.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td>
              {r.value}
              {r.note && <span class="dd-cond__note">（{r.note}）</span>}
              {r.source && num(r.source) > 0 && (
                <sup>
                  <a href={`#src-${r.source}`}>[{num(r.source)}]</a>
                </sup>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {hidden && <p class="dd-stale">この条件は再確認中です。最新の条件は公式の案内で確認してください。</p>}
  </CheckSlip>
</div>
