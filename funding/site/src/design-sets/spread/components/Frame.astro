---
import type { FrameProps } from "../../contract";
type Props = FrameProps;
const p = Astro.props;
const cur = (b?: boolean) => (b ? "page" : undefined);
// 中身が無いとき has("check") が true になり、空の aside が出る
const checkHtml = ((await Astro.slots.render("check")) ?? "").trim();
const afterHtml = ((await Astro.slots.render("after")) ?? "").trim();
---

<div class="sp-frame" data-page={p.page} data-sig="s1">
  <a class="dd-skip" href="#main">
    本文へ移動
  </a>
  <header class="sp-bar">
    <a class="sp-logo" href={p.homeHref} data-logo>
      {p.siteName}
    </a>
    <a class="sp-bar__btn" href={p.searchHref}>
      検索
    </a>
    <button class="sp-bar__btn" type="button" popovertarget="sp-index">
      索引
    </button>
  </header>
  <nav class="sp-tabstrip" aria-label="棚">
    <a class="sp-stamp-link" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
      ホーム
    </a>
    {p.shelves.map((s) => (
      <a class="sp-stamp-link" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
        {s.label}
      </a>
    ))}
  </nav>
  <nav class="sp-sub" id="sp-index" aria-label="索引" popover>
    <a class="sp-logo" href={p.homeHref} data-logo>
      {p.siteName}
      <small>{p.tagline}</small>
    </a>
    <ul class="sp-stamps" data-sig="s8">
      <li>
        <a class="sp-stamp-link" href={p.homeHref} aria-current={cur(p.homeCurrent)}>
          ホーム
        </a>
      </li>
      {p.shelves.map((s) => (
        <li>
          <a class="sp-stamp-link" href={s.href} style={`--slot:${s.slot}`} aria-current={cur(s.current)}>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
    {p.questions && p.questions.length > 0 && (
      <ul class="sp-questions">
        {p.questions.map((q) => (
          <li>
            <a class="sp-q" href={q.href}>
              {q.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    <form class="sp-dome" role="search" aria-label="索引の検索" action={p.searchHref} method="get">
      <label class="dd-visually-hidden" for="sp-q">
        キーワードで検索
      </label>
      <input id="sp-q" name="q" type="search" value={p.query ?? ""} placeholder="キーワードで検索" />
      <button type="submit">検索</button>
    </form>
    <p class="sp-sub__h" id="sp-purpose-h">
      目的から探す
    </p>
    <ul class="sp-purpose" aria-labelledby="sp-purpose-h">
      {p.purposes.map((x) => (
        <li>
          <a href={x.href} aria-current={cur(x.current)}>
            {x.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="sp-utility">
      {p.utility.map((u) => (
        <li>
          <a href={u.href} aria-current={cur(u.current)}>
            {u.label}
          </a>
        </li>
      ))}
      <li>
        <button type="button" popovertarget="dd-settings">
          表示設定
        </button>
      </li>
    </ul>
  </nav>
  <main id="main" class="sp-faces" tabindex="-1">
    <div class="sp-face">
      <slot />
    </div>
    {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
    {afterHtml.length > 0 && <section class="sp-nextface" set:html={afterHtml} />}
  </main>
  {/* eslint-disable-next-line astro/no-set-html-directive -- Astro.slots.render の結果（Astro がエスケープ済みの HTML） */}
  {checkHtml.length > 0 && <aside class="sp-spine" aria-label="確かめる" set:html={checkHtml} />}
  <footer class="sp-footer">
    <ul>
      {p.footer.map((f) => (
        <li>
          <a href={f.href}>{f.label}</a>
        </li>
      ))}
    </ul>
  </footer>
</div>
